# Copy this file to `.env` on the server and edit the values for that cluster.
# The scripts read `.env` from the project root by default.

# ---------- cluster ----------
WORKDIR=/data1/liguowei/SpeciesLLM
HOSTS=7.150.12.45,7.150.15.14,7.150.14.170
MASTER_ADDR=7.150.12.45
MASTER_PORT=12345
SSH_USER=root

# Prefer SSH_KEY when available. Keep SSH_PASSWORD empty unless password login
# is required by your servers.
SSH_KEY=
SSH_PASSWORD=
SSH_EXTRA_OPTS=

NNODES=3
AUTO_NNODES=1
NPROC_PER_NODE=8
SYNC_SELF=1
DRY_RUN=0

# ---------- data and embeddings ----------
# TRAIN_DATASET=full uses:
#   ${DATA_ROOT}/all_shuffled_data
# TRAIN_DATASET=test uses:
#   ${DATA_ROOT}/all_shuffled_data_test
TRAIN_DATASET=test
DATA_ROOT=/data1/liguowei/SpeciesLLM/Stage2_SpeciesLLMData

# Embeddings can live under a different prefix from DATA_ROOT.
# The default embedding path is:
#   ${EMB_ROOT}/Stage2_macrogene_embeddings
EMB_ROOT=/data2/liguowei/SpeciesLLM

# If the directory names are not the defaults above, override the full paths
# directly instead of using DATA_ROOT/EMB_ROOT.
# DATA_PATH=/data/path/to/all_shuffled_data_test
# EMB_PATH=/embedding/path/to/Stage2_macrogene_embeddings

# ---------- training ----------
SEQ_LEN=640
BATCH_SIZE=32
EPOCH=10
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=0.00001
MIN_LR=0.000001
DECAY_LR=true
WARMUP_ITERS=2000
WARMUP_RATIO=0.05
WEIGHT_DECAY=0.1
SAVE_DATA_INTERVAL=5120000
COMPILE=true

# ---------- Ascend / HCCL ----------
ASCEND_RT_VISIBLE_DEVICES_VALUE=0,1,2,3,4,5,6,7
HCCL_CONNECT_TIMEOUT=7200
HCCL_EXEC_TIMEOUT=7200
HCCL_WHITELIST_DISABLE=1
ASCEND_TOOLKIT_HOME=/usr/local/Ascend/ascend-toolkit/latest
